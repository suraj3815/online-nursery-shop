@model IEnumerable<PlantShopApp.Models.Order>

@{
    ViewData["Title"] = "My Orders";
}

<h2 class="mb-4"><i class="fa-solid fa-box"></i> My Orders</h2>

@if (!Model.Any())
{
    <div class="alert alert-info shadow-sm">You haven't placed any orders yet. <a asp-controller="Shop" asp-action="Index" class="alert-link">Start shopping!</a></div>
}
else
{
    <div class="row">
        @foreach (var order in Model)
        {
            <div class="col-12 mb-4">
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Order #@order.OrderId</h5>
                        <span>@order.OrderDate.ToString("dd MMM yyyy")</span>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-8">
                                <h6 class="text-muted mb-3">Items Ordered:</h6>
                                <ul class="list-group list-group-flush mb-3 mb-md-0">
                                    @foreach (var item in order.OrderItems)
                                    {
                                        <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                            <div class="d-flex align-items-center">
                                                <img src="@(item.Product?.ImageUrl ?? "/images/default.jpg")" alt="@item.Product?.Name" style="width: 60px; height: 60px; object-fit: cover; border-radius: 8px;" class="me-3 shadow-sm" />
                                                <div>
                                                    <h6 class="mb-0 fw-bold">@item.Product?.Name</h6>
                                                    <small class="text-muted">Qty: @item.Quantity</small>
                                                </div>
                                            </div>
                                            <span class="text-success fw-bold">₹ @item.Price</span>
                                        </li>
                                    }
                                </ul>
                            </div>
                            <div class="col-md-4 border-start">
                                <h6 class="text-muted mb-3">Order Summary:</h6>
                                <p class="mb-2 d-flex justify-content-between"><span>Total Amount:</span> <strong class="text-success fs-5">₹ @order.TotalAmount</strong></p>
                                <p class="mb-3 d-flex justify-content-between align-items-center">
                                    <span>Status:</span> 
                                    <span>
                                        @if (order.Status == "Pending")
                                        {
                                            <span class="badge bg-danger rounded-pill px-3 py-2"><i class="fa-solid fa-clock"></i> Pending</span>
                                        }
                                        else if (order.Status == "Shipped")
                                        {
                                            <span class="badge bg-warning text-dark rounded-pill px-3 py-2"><i class="fa-solid fa-truck"></i> Shipped</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success rounded-pill px-3 py-2"><i class="fa-solid fa-check"></i> Delivered</span>
                                        }
                                    </span>
                                </p>
                                <div class="bg-light p-3 rounded text-center border">
                                    <small class="text-muted d-block mb-1"><i class="fa-solid fa-calendar-check text-success"></i> Expected Delivery</small>
                                    <strong class="text-dark">@order.OrderDate.AddDays(4).ToString("dddd, dd MMM yyyy")</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
