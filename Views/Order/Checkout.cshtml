@{
    ViewData["Title"] = "Checkout";
}

<h2 class="mb-4">Secure Checkout</h2>

<div class="row">
    <div class="col-md-7">
        <div class="card shadow-sm p-4 mb-4" style="border-radius: 15px; border: none;">
            <h3 class="text-success mb-4">Delivery Details</h3>
            <form asp-action="PlaceOrder" method="post">
                <div class="mb-3">
                    <label class="form-label fw-bold">Complete Address</label>
                    <textarea name="address" class="form-control" rows="4" required placeholder="Enter your full delivery address..."></textarea>
                </div>
                <div class="mb-4">
                    <label class="form-label fw-bold">Payment Method</label>
                    <div class="p-3 rounded" style="background-color: #e8f5e9; border: 1px solid #2e7d32; color: #2e7d32;">
                        <i class="fa-solid fa-money-bill-wave"></i> Cash on Delivery (COD)
                    </div>
                </div>
                <button type="submit" class="btn btn-primary btn-lg w-100">Place Order</button>
            </form>
        </div>
    </div>
    
    <div class="col-md-5">
        <div class="card shadow-sm p-4" style="border-radius: 15px; border: none; background-color: #f8f9fa;">
            <h3 class="mb-4">Order Summary</h3>
            <p class="text-muted">Your items will be reviewed here.</p>
            <a asp-controller="Cart" asp-action="Index" class="btn btn-outline-secondary w-100">Back to Cart</a>
        </div>
    </div>
</div>
