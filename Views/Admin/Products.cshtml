@model IEnumerable<PlantShopApp.Models.Product>

@{
    ViewData["Title"] = "Admin - Manage Products";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2><i class="fa-solid fa-user-shield"></i> Admin Panel - Manage Plants</h2>
    <a asp-action="CreateProduct" class="btn btn-outline-success"><i class="fa-solid fa-plus"></i> Add New Plant</a>
</div>

<div class="table-responsive bg-white rounded shadow-sm">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-success">
            <tr>
                <th>ID</th>
                <th>Image</th>
                <th>Name</th>
                <th>Price</th>
                <th>Stock</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ProductId</td>
                    <td><img src="@item.ImageUrl" alt="@item.Name" style="width: 50px; height: 50px; object-fit: cover; border-radius: 8px;" /></td>
                    <td><strong>@item.Name</strong></td>
                    <td>₹ @item.Price</td>
                    <td>@item.Stock</td>
                    <td>
                        <a asp-action="EditProduct" asp-route-id="@item.ProductId" class="btn btn-sm btn-outline-primary me-2"><i class="fa-solid fa-pen"></i></a>
                        <form asp-action="DeleteProduct" asp-route-id="@item.ProductId" method="post" style="display:inline;">
                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Are you sure?');"><i class="fa-solid fa-trash"></i></button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<div class="mt-4">
    <a asp-action="Orders" class="btn btn-primary"><i class="fa-solid fa-list-check"></i> Manage Customer Orders</a>
</div>
