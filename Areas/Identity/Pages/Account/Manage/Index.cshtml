@page
@model IndexModel
@{
    ViewData["Title"] = "Profile Information";
    ViewData["ActivePage"] = ManageNavPages.Index;
}

<h3 class="fw-bold mb-4">@ViewData["Title"]</h3>
<partial name="_StatusMessage" for="StatusMessage" />

<form id="profile-form" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
    
    <div class="form-floating mb-4">
        <input asp-for="Username" class="form-control" placeholder="Please choose your username." disabled style="border-radius: 10px; background-color: #f8f9fa; border: 1px solid #eaeaea;" />
        <label asp-for="Username" class="form-label">Username (Email)</label>
    </div>
    
    <div class="form-floating mb-4">
        <input asp-for="Input.PhoneNumber" class="form-control" placeholder="Please enter your phone number." style="border-radius: 10px;" />
        <label asp-for="Input.PhoneNumber" class="form-label">Phone Number (Optional)</label>
        <span asp-validation-for="Input.PhoneNumber" class="text-danger"></span>
    </div>
    
    <button id="update-profile-button" type="submit" class="btn btn-primary w-100 py-3" style="border-radius: 10px; font-weight: 600; font-size: 1.1rem; box-shadow: 0 4px 15px rgba(46,125,50,0.3);">
        <i class="fa-solid fa-floppy-disk me-2"></i> Save Profile Changes
    </button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
